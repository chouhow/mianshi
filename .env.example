# 复制为 .env 并填入自己的凭据（.env 已被 .gitignore 忽略，不会入库）
# 设置页留空的字段会自动读取 .env；设置页显式配置的值优先

# ---- 语音识别（火山引擎流式 ASR）----
# 旧版控制台：App ID + Access Token；新版控制台：API Key（二选一）
ASR_APP_ID=
ASR_ACCESS_TOKEN=
ASR_API_KEY=
# 一般保持默认
ASR_WS_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel
ASR_RESOURCE_ID=volc.bigasr.sauc.duration
ASR_UID=mianshi_user

# ---- 大模型（火山方舟，OpenAI 兼容）----
ARK_API_KEY=
ARK_MODEL=
# 一般保持默认
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
